# Copie para .env e preencha os campos vazios. O .env NUNCA vai para o repositório
# (está no .gitignore) e não pode acompanhar o .zip da entrega.
#
#   cp .env.example .env
#
# Os campos já preenchidos são valores de desenvolvimento, sem segredo nenhum.
# Os vazios são senhas e chaves: cada um preenche com o que combinar com a equipe.

# --- PostgreSQL (schema por serviço: conta, cliente, gerente) ----------------
POSTGRES_USER=bantads
POSTGRES_DB=bantads
POSTGRES_PASSWORD=

# --- Redis (sessões, jobs, estado das SAGAs e cache) ------------------------
REDIS_PASSWORD=

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# --- MS Email ---------------------------------------------------------------
# Conta Gmail da equipe. A senha de APLICATIVO (16 caracteres) é gerada em
# https://myaccount.google.com/apppasswords e exige verificação em duas etapas.
# Não é a senha normal da conta.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- API Gateway ------------------------------------------------------------
# Chave de assinatura do JWT: só o Gateway a conhece. Gere uma string longa e
# aleatória, por exemplo com `openssl rand -base64 32`.
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200

# --- Rodando os serviços fora do Docker -------------------------------------
# Dentro do compose os serviços se acham pelo nome e estas variáveis são
# desnecessárias. Descomente só se subir algum MS na mão, fora da frota.
# MS_CONTA_URL=http://localhost:8080
# MS_AUTH_URL=http://localhost:8081
# MS_CLIENTE_URL=http://localhost:8082
# MS_GERENTE_URL=http://localhost:8083
