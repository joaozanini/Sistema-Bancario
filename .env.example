# Modelo do .env: copie para .env e preencha os campos vazios

# --- PostgreSQL (schema por serviço: conta, cliente, gerente) ----------------
POSTGRES_USER=bantads
POSTGRES_DB=bantads
POSTGRES_PASSWORD=
# Porta do Postgres no host
POSTGRES_PORT_HOST=5432

# --- Redis (sessões, jobs, estado das SAGAs e cache) ------------------------
REDIS_PASSWORD=

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# --- MS Email ---------------------------------------------------------------
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- API Gateway ------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200

# --- Rodando os serviços fora do Docker -------------------------------------
# MS_CONTA_URL=http://localhost:8080
# MS_AUTH_URL=http://localhost:8081
# MS_CLIENTE_URL=http://localhost:8082
# MS_GERENTE_URL=http://localhost:8083
