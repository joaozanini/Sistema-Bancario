# Copie para .env (cp .env.example .env) e preencha as senhas; o docker compose lê o .env sozinho.
# POSTGRES_PASSWORD, REDIS_PASSWORD, RABBITMQ_PASSWORD e JWT_SECRET são obrigatórias.

# Configuração do BD Postgres
POSTGRES_USER=bantads
POSTGRES_PASSWORD=
POSTGRES_DB=bantads

REDIS_PASSWORD=

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# MS Email (SMTP Gmail - senha de app: https://myaccount.google.com/apppasswords)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Configuração do API Gateway
CORS_ORIGIN=http://localhost:4200

# JWT (chave secreta nunca commitada com valor real)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Só para rodar o API Gateway fora do Docker; no compose os endereços são os nomes dos contêineres
# PORT=3000
# MS_CONTA_URL=http://localhost:8080
# MS_AUTH_URL=http://localhost:8081
# MS_CLIENTE_URL=http://localhost:8082
# MS_GERENTE_URL=http://localhost:8083
