server.port=${SERVER_PORT:8080}

# Configurações do Banco de Dados
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:5432/${POSTGRES_DB:bantads}
spring.datasource.username=${POSTGRES_USER}
spring.datasource.password=${POSTGRES_PASSWORD}

# Schema próprio do serviço (schema-per-service): as tabelas e a flyway_schema_history ficam nele
spring.flyway.schemas=${DB_SCHEMA:conta}
spring.flyway.default-schema=${DB_SCHEMA:conta}
spring.jpa.properties.hibernate.default_schema=${DB_SCHEMA:conta}

# Validar o schema ao invés de usar auto ddl
spring.jpa.hibernate.ddl-auto=validate

# Configurações do Flyway
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# RabbitMQ: comandos da SAGA (ms.conta.cmd) e eventos do CQRS (ms.conta.events)
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:admin}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:}
