server.port=${SERVER_PORT:8083}

# Configurações do Banco de Dados
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:5432/${POSTGRES_DB:bantads}
spring.datasource.username=${POSTGRES_USER}
spring.datasource.password=${POSTGRES_PASSWORD}

# Schema próprio do serviço
spring.flyway.schemas=${DB_SCHEMA:gerente}
spring.flyway.default-schema=${DB_SCHEMA:gerente}
spring.jpa.properties.hibernate.default_schema=${DB_SCHEMA:gerente}

# Valida o schema sem auto ddl
spring.jpa.hibernate.ddl-auto=validate

# Configurações do Flyway
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# RabbitMQ: consumidor de ms.gerente.cmd
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:admin}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:}

# Retentativa a cada 5s antes da DLQ
spring.rabbitmq.listener.simple.retry.enabled=true
spring.rabbitmq.listener.simple.retry.max-retries=3
spring.rabbitmq.listener.simple.retry.initial-interval=5s
spring.rabbitmq.listener.simple.retry.multiplier=1
spring.rabbitmq.listener.simple.retry.max-interval=5s
spring.rabbitmq.listener.simple.default-requeue-rejected=false
