spring.application.name=ms-orquestrador
server.port=8090

# RabbitMQ
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:admin}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:}

# Retentativa a cada 5s antes de cair na DLQ (enunciado 5.7).
# max-retries conta as tentativas APOS a entrega inicial: 1 + 3 = 4 entregas,
# a ultima em t=15s — que e o "~15-20 s" citado no enunciado.
# Em Boot 4 a antiga max-attempts foi removida (deprecated level=error).
spring.rabbitmq.listener.simple.retry.enabled=true
spring.rabbitmq.listener.simple.retry.max-retries=3
spring.rabbitmq.listener.simple.retry.initial-interval=5s
# multiplier=1 mantem o intervalo fixo em 5s (sem backoff exponencial)
spring.rabbitmq.listener.simple.retry.multiplier=1
spring.rabbitmq.listener.simple.retry.max-interval=5s
# Esgotadas as tentativas, a mensagem e rejeitada SEM voltar para a fila —
# so assim ela cai na DLQ via x-dead-letter-*. Com o padrao (true) entraria em loop.
spring.rabbitmq.listener.simple.default-requeue-rejected=false

# Redis (estado das SAGAs a partir da S6)
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}

# SAGA (enunciado 5.9): prazo de resposta de cada passo transacional
saga.timeout-passo=30s
saga.timeout.verificar=true
saga.timeout.intervalo-verificacao=1s
